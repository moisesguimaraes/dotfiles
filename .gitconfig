[user]
  name = Moisés Guimarães de Medeiros
  email = contact@moisesguimaraes.com
[core]
  editor = vi
  whitespace = warn
  excludesfile = ~/.gitignore
[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
[alias]
  c = commit
  ca = commit --amend
  can = commit -amend --no-edit
  cm = commit -m
  dc = diff --cached
  d = diff
  lg = log --all --graph --abbrev-commit --decorate --date=format:\"%a, %d %b %Y %H:%M\" --format=format:\"%C(bold blue)%h%C(reset) - %C(bold cyan)%ad %C(bold green)(%ar)%C(bold yellow)%d %C(dim white)%an%n          %C(white)%s%n\"
  s = status
[filter "lfs"]
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
[gitreview]
  username = moguimar
