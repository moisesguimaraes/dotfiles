[user]
  name = Moisés Guimarães de Medeiros
  email = contact@moisesguimaraes.com
[core]
  editor = vi
  whitespace = warn
  excludesfile = ~/.gitignore
[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
[init]
  defaultBranch = master
[web]
  browser = google-chrome
[credential]
  helper = osxkeychain
[push]
  default = simple
[merge]
  tool = kdiff3
[difftool]
  prompt = false
[alias]
  c = commit
  ca = commit --amend
  can = commit --amend --no-edit
  cm = commit -m
  d = diff
  dc = diff --cached
  l = log --graph --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" --abbrev-commit
  lg = log --all --graph --abbrev-commit --decorate --date=format:\"%a, %d %b %Y %H:%M\" --format=format:\"%C(bold blue)%h%C(reset) - %C(bold cyan)%ad %C(bold green)(%ar)%C(bold yellow)%d %C(dim white)%an%n          %C(white)%s%n\"
  s = status
[pull]
  rebase = false